
@model IEnumerable<GestionProductosNet10.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container py-4">

    <!-- Botón para registrar productos -->
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Productos"
           asp-action="Crear"
           class="btn btn-success">
            + Registrar producto
        </a>
    </div>

    <!-- Encabezado principal -->
    <div class="mb-4">
        <h2 class="fw-bold text-primary">
            Gestión de Productos
        </h2>

        <p class="text-muted">
            Sistema de administración y control de productos.
        </p>
    </div>

    <!-- Mensaje de confirmación -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <!-- Tabla de productos -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                Listado de productos
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Fecha de registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var producto in Model)
                            {
                                <tr>
                                    <td>
                                        @producto.IdProducto
                                    </td>

                                    <td>
                                        @producto.Nombre
                                    </td>

                                    <td>
                                        @producto.Descripcion
                                    </td>

                                    <td>
                                        $ @producto.Precio.ToString("N2")
                                    </td>

                                    <td>
                                        @producto.Stock
                                    </td>

                                    <td>
                                        @producto.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <!-- Botón para editar -->
                                        <a asp-controller="Productos"
                                           asp-action="Editar"
                                           asp-route-id="@producto.IdProducto"
                                           class="btn btn-warning btn-sm">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    No hay productos registrados actualmente.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
